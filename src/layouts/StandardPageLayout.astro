---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { client } from "../lib/client";
import AppointmentCallout from "../components/AppointmentCallout.astro";
import "../styles/interior.css";

interface Props {
  title: string;
  description?: string;
  /** Chapô sous le titre ; par défaut la description SEO. */
  intro?: string;
  /** La page fournit son propre en-tête (ex. à propos avec portrait). */
  hidePageHeader?: boolean;
  heading?: string;
  showAppointment?: boolean;
}

const {
  title,
  description = "",
  intro = description,
  hidePageHeader = false,
  heading = title,
  showAppointment = true,
} = Astro.props;
---

<BaseLayout title={`${title} — ${client.seo.siteName}`} description={description}>
  <Header />
  <Breadcrumb currentLabel={title} />

  <main id="contenu" class="home-container interior-page" data-component="page">
    {
      !hidePageHeader && (
        <header class:list={["page-header", Astro.slots.has("actions") && "page-header--actions"]}>
          <h1>{heading}</h1>
          {intro && <p class="lead">{intro}</p>}
          <slot name="actions" />
        </header>
      )
    }

    <div class="page-content">
      <slot />
    </div>
    {showAppointment && <AppointmentCallout />}
  </main>
</BaseLayout>
