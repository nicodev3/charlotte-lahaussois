---
import { getCollection, render } from "astro:content";
import StandardPageLayout from "../layouts/StandardPageLayout.astro";
import { client } from "../lib/client";
import { isPublishedEntry } from "../lib/contentNavigation";
import {
  REGISTERED_PRACTICE_PAGES,
  practicePageContentId,
  practicePageEntryMatchesContentId,
} from "../lib/practicePageRegistry";
import { getSiteNavigation } from "../lib/siteNavigation";
import { ArrowRight } from "@lucide/astro";

export async function getStaticPaths() {
  const entries = await getCollection("practicePages", isPublishedEntry);

  return REGISTERED_PRACTICE_PAGES.filter(
    (page) => client.practicePageEnabled[page.id] === true,
  ).map((page) => {
    const contentId = practicePageContentId(page.slug);
    const entry = entries.find((e) => practicePageEntryMatchesContentId(e.id, contentId));
    if (!entry) {
      throw new Error(
        `[practicePages] Page pratique "${page.id}" activée (client.practicePageEnabled) mais fichier manquant : src/content/practice-pages/${contentId}`,
      );
    }
    return {
      params: { practicePage: page.slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { practices } = await getSiteNavigation();
---

<StandardPageLayout title={entry.data.title} description={entry.data.description ?? ""}>
  <div class="practice-layout">
    <article class="content-rich" data-component="content.practice-page"><Content /></article>
    <aside class="practice-navigation" aria-labelledby="practice-nav-title">
      <h2 id="practice-nav-title">Mes approches</h2><nav aria-label="Autres approches">
        {
          practices.map((practice) => (
            <a
              href={practice.href}
              aria-current={
                Astro.url.pathname.replace(/\/?$/, "/") === practice.href ? "page" : undefined
              }
            >
              {practice.label}
              <ArrowRight size={17} aria-hidden="true" />
            </a>
          ))
        }
      </nav><a class="home-text-link" href="/a-propos/"
        >Mon parcours<ArrowRight size={17} aria-hidden="true" /></a>
    </aside>
  </div>
</StandardPageLayout>
