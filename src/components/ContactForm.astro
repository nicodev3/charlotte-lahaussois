---
import { FORMSPREE_FORM_ID } from "../lib/constants";
import { client } from "../lib/client";

const nextUrl = `${client.seo.baseUrl.replace(/\/+$/, "")}/contact/?sent=1`;
const action = `https://formspree.io/f/${FORMSPREE_FORM_ID}`;
const sent = Astro.url.searchParams.get("sent") === "1";
---

<section
  id="ecrire"
  class="page-block"
  aria-labelledby="contact-form-heading"
  data-component="contact.form"
>
  <h2 id="contact-form-heading">Envoyer un message</h2>
  <p class="note">
    Une réponse vous est apportée rapidement, généralement sous 24 à 48 heures ouvrées.
  </p>

  {
    sent && (
      <p role="status" aria-live="polite">
        Merci : votre message a bien été envoyé.
      </p>
    )
  }

  <form class="space-y-4" method="POST" action={action}>
    <input type="hidden" name="_next" value={nextUrl} />
    <input
      type="hidden"
      name="_subject"
      value={`Message depuis le site — ${client.seo.siteName}`}
    />

    <p class="sr-only" aria-hidden="true">
      <label>
        Ne pas remplir ce champ
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <label for="contact-name">
          Nom <span aria-hidden="true">*</span>
        </label>
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          autocomplete="name"
          class="form-field"
        />
      </div>

      <div>
        <label for="contact-email">
          E-mail <span aria-hidden="true">*</span>
        </label>
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class="form-field"
        />
      </div>
    </div>

    <div>
      <label for="contact-phone">Téléphone</label>
      <input id="contact-phone" name="phone" type="tel" autocomplete="tel" class="form-field" />
    </div>

    <div>
      <label for="contact-message">
        Message <span aria-hidden="true">*</span>
      </label>
      <textarea id="contact-message" name="message" required rows={5} class="form-field"></textarea>
      <p class="note">Les champs marqués d’un * sont obligatoires.</p>
    </div>

    <p class="note">Vos informations restent confidentielles et ne sont jamais partagées.</p>
    <button type="submit" class="cta-primary"> Envoyer le message </button>
  </form>
</section>
