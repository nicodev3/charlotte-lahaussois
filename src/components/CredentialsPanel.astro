---
import { client } from "../lib/client";

const c = client.credentials;
const b = client.business;
const licenseKindLabel = c.license.registrationLabel === "rpps" ? "RPPS" : "ADELI";
---

<section class="page-block" data-component="panel.credentials">
  <h2>Formations et qualifications</h2>
  <p class="note">
    {b.title}
    {c.license.rppsOrAdeli && ` • ${licenseKindLabel} : ${c.license.rppsOrAdeli}`}
    {typeof c.experienceYears === "number" ? ` • ${c.experienceYears} ans d'expérience` : ""}
  </p>

  {
    c.degrees.length > 0 && (
      <div data-component="credentials.degrees">
        <p class="note">Diplômes</p>
        <ul>
          {c.degrees.map((item) => (
            <li>
              <span>{item.label}</span>
              {item.institution ? <span> — {item.institution}</span> : null}
              {item.year ? <span> ({item.year})</span> : null}
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    c.trainings.length > 0 && (
      <div data-component="credentials.trainings">
        <p class="note">Formations</p>
        <ul>
          {c.trainings.map((item) => (
            <li>
              <span>{item.label}</span>
              {item.provider ? <span> — {item.provider}</span> : null}
              {item.year ? <span> ({item.year})</span> : null}
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    c.affiliations.length > 0 && (
      <p data-component="credentials.affiliations">Affiliations — {c.affiliations.join(" • ")}</p>
    )
  }
</section>
