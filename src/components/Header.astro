---
import { ArrowRight, Menu } from "@lucide/astro";
import { client } from "../lib/client";
import { resolvedBookingPrimaryHref, bookingPrimaryIsExternal } from "../lib/client/siteBooking";

const b = client.business;
const bookingHref = resolvedBookingPrimaryHref(client);
const bookingAttributes = bookingPrimaryIsExternal(bookingHref)
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
const links = [
  { href: "/pourquoi-consulter/", label: "Pourquoi consulter ?" },
  { href: "/a-propos/", label: "Mon approche" },
  { href: "/tarifs/", label: "Tarifs" },
];
const currentPath = Astro.url.pathname.replace(/\/?$/, "/");
---

<a class="home-skip-link" href="#contenu">Aller au contenu</a>
<header class="home-header">
  <div class="home-container home-header-inner">
    <a class="home-brand" href="/" aria-label={`Accueil — ${b.fullName}`}>
      <span class="home-brand-mark" aria-hidden="true">cl.</span>
      <span><strong>{b.fullName}</strong><span>{b.title}</span></span>
    </a>
    <nav class="home-desktop-nav" aria-label="Navigation principale">
      {
        links.map((link) => (
          <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
      <a class="home-button home-button-small" href={bookingHref} {...bookingAttributes}>
        Prendre rendez-vous <ArrowRight size={17} aria-hidden="true" />
      </a>
    </nav>
    <details class="home-menu">
      <summary aria-label="Ouvrir ou fermer le menu"><Menu size={25} aria-hidden="true" /></summary>
      <nav aria-label="Navigation mobile">
        {
          links.map((link) => (
            <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>
              {link.label}
            </a>
          ))
        }
        <a href="/contact/" aria-current={currentPath === "/contact/" ? "page" : undefined}
          >Contact</a
        >
        <a class="home-button" href={bookingHref} {...bookingAttributes}>Prendre rendez-vous</a>
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>(".home-menu");
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
  document.addEventListener("click", (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target))
      menu.open = false;
  });
</script>
