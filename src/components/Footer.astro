---
import { CalendarDays, ExternalLink, Mail, Phone } from "@lucide/astro";
import { getArticleNavigation } from "../lib/contentNavigation";
import { buildFooterSiteMapItems } from "../lib/footerSiteMap";
import { getSiteNavigation } from "../lib/siteNavigation";
import { client } from "../lib/client";
import { professionDeontologieFooterLink } from "../lib/client/professionCopy.ts";
import { businessStreetLines } from "../lib/client/businessAddress";
import {
  bookingPrimaryIsExternal,
  resolvedBookingPrimaryHref,
  SITE_BOOKING_PRIMARY_LABEL,
} from "../lib/client/siteBooking";
import { SITE_BOOKING_SECONDARY_HREF, SITE_BOOKING_SECONDARY_LABEL } from "../lib/constants";

const b = client.business;
const license = client.credentials.license;
const registrationLabel = license.registrationLabel === "rpps" ? "RPPS" : "ADELI";
const bookingHref = resolvedBookingPrimaryHref(client);
const bookingExternal = bookingPrimaryIsExternal(bookingHref);

const { main, practices } = await getSiteNavigation();
const publishedArticles = await getArticleNavigation({ includeDrafts: false });
const siteMapItems = buildFooterSiteMapItems({
  mainNavItems: main,
  practiceNavItems: practices,
  publishedArticles: publishedArticles.map((a) => ({ label: a.title, href: a.href })),
});

const deontologie = professionDeontologieFooterLink(client.profession);
---

<footer data-component="ui.footer">
  <p class="px-4 py-3 text-center text-sm leading-relaxed md:px-6">
    En cas d'urgence psychiatrique ou de risque immédiat, contactez le 15 (SAMU) ou le 112.
  </p>
  <div class="pt-8 md:pt-10">
    <div class="site-container mb-8 grid grid-cols-1 gap-6 md:grid-cols-3">
      <address class="space-y-1 not-italic" data-component="footer.contact">
        <p class="text-base leading-relaxed">{b.fullName}</p>
        <p class="text-sm leading-relaxed">{b.title} • {b.city}</p>
        <p class="text-sm leading-relaxed">
          {
            businessStreetLines(b).map((line) => (
              <>
                {line}
                <br />
              </>
            ))
          }
          {b.postalCode}&nbsp;{b.city}
        </p>
        <p class="text-sm leading-relaxed">
          <a class="inline-flex items-center gap-1.5" href={`tel:${b.phone.replace(/\s/g, "")}`}>
            <Phone class="size-4 shrink-0" size={16} aria-hidden="true" />
            {b.phone}
          </a>
        </p>
        <p class="text-sm leading-relaxed">
          <a class="inline-flex items-center gap-1.5" href={`mailto:${b.email}`}>
            <Mail class="size-4 shrink-0" size={16} aria-hidden="true" />
            {b.email}
          </a>
        </p>
        {
          license.rppsOrAdeli && (
            <p class="text-sm leading-relaxed">
              {registrationLabel} : {license.rppsOrAdeli}
            </p>
          )
        }
        {
          client.social.links.length > 0 && (
            <ul class="flex flex-wrap gap-x-3 gap-y-1 pt-2">
              {client.social.links.map((link) => (
                <li>
                  <a
                    class="text-sm leading-relaxed"
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </address>

      <div class="flex flex-col items-start gap-2" data-component="footer.booking">
        <a
          class="cta-primary cta-primary--footer"
          href={bookingHref}
          {...bookingExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}}
        >
          <CalendarDays class="size-4 shrink-0" size={16} aria-hidden="true" />
          {SITE_BOOKING_PRIMARY_LABEL}
        </a>
        <a class="text-base" href={SITE_BOOKING_SECONDARY_HREF}>{SITE_BOOKING_SECONDARY_LABEL}</a>
      </div>

      <div class="flex flex-col gap-3" data-component="footer.sitemap">
        <h2 class="text-base">Plan du site</h2>
        <nav class="flex flex-col gap-3" aria-label="Navigation pied de page">
          {
            siteMapItems.map((item) => (
              <a class="text-sm" href={item.href}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </div>

    <div
      class="site-container flex flex-wrap justify-between gap-x-6 gap-y-2 py-4 text-sm"
      data-component="footer.legal"
    >
      <span>
        © {new Date().getFullYear()} &ndash; {b.fullName}
        {b.siret && <span> • SIRET : {b.siret}</span>}
      </span>

      <ul class="flex flex-wrap gap-x-3 gap-y-1">
        <li><a href="/mentions-legales/">Mentions légales</a></li>
        <li><a href="/mentions-legales/#donnees-personnelles">Données personnelles</a></li>
        {
          deontologie && (
            <li>
              <a
                class="inline-flex items-center gap-1"
                href={deontologie.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {deontologie.label}
                <ExternalLink class="size-3.5 shrink-0" size={14} aria-hidden="true" />
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
</footer>
