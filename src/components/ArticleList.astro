---
import { getArticleNavigation } from "../lib/contentNavigation";
import { ArrowRight, BookOpen } from "@lucide/astro";

const articles = await getArticleNavigation();
---

<section data-component="content.article-list">
  {
    articles.length > 0 ? (
      <ul>
        {articles.map((article) => (
          <li>
            <a href={article.href}>
              <h2>{article.title}</h2>
              {article.description && <p class="note">{article.description}</p>}
              <span class="home-text-link">
                Lire l’article
                <ArrowRight size={18} aria-hidden="true" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="articles-empty">
        <>
          <BookOpen size={32} stroke-width={1.5} aria-hidden="true" />
          <h2>Un espace pour prolonger la réflexion.</h2>
          <p>Aucun article publié pour le moment.</p>
          <a class="home-text-link" href="/a-propos/">
            Découvrir mon approche
            <ArrowRight size={18} aria-hidden="true" />
          </a>
        </>
      </div>
    )
  }
</section>
