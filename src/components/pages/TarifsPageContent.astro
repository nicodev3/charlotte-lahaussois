---
import ConditionsPanel from "../ConditionsPanel.astro";
import MonSoutienPsyCallout from "../MonSoutienPsyCallout.astro";
import { client } from "../../lib/client";
import { getSiteCopy } from "../../lib/siteCopy";
import { REIMBURSEMENT_MUTUELLE_NOTICE } from "../../lib/constants";

const copy = await getSiteCopy("tarifs");
const pricingItems =
  copy.data.items && copy.data.items.length > 0 ? copy.data.items : client.pricing.items;
const reducedRateNote = client.pricing.reducedRateNote ?? "";
---

<section
  class="pricing-overview"
  aria-label="Tarifs des consultations"
  data-component="pricing.list"
>
  <ul class="pricing-offers">
    {
      pricingItems.map((it) => (
        <li data-component="pricing.item">
          <div>
            <h2>{it.name}</h2>
            {it.note && <p>{it.note}</p>}
          </div>
          <p class="pricing-amount">
            {it.price}
            <span> €</span>
          </p>
          <p class="pricing-duration">Une séance de {it.durationMinutes} minutes</p>
        </li>
      ))
    }
  </ul>
  <div class="pricing-context">
    <h2>Un temps pour vous,<br />un cadre partagé.</h2><p>
      Retrouvez les modalités de règlement et les conditions du suivi ci-dessous.
    </p>{reducedRateNote && <p class="pricing-reduced">{reducedRateNote}</p>}
  </div>
</section>

<div class="pricing-details">
  <section class="page-block" data-component="pricing.payment">
    <h2>Moyens de paiement</h2>
    <ul>
      {client.pricing.payment.map((payment) => <li>{payment}</li>)}
    </ul>
  </section>

  <section class="page-block" data-component="pricing.reimbursement">
    <h2>Remboursement</h2>
    <p>
      Les consultations ne sont pas remboursées par la Sécurité sociale. {
        REIMBURSEMENT_MUTUELLE_NOTICE
      }
    </p>
    <MonSoutienPsyCallout headingLevel={3} />
  </section>
</div>

<ConditionsPanel />
