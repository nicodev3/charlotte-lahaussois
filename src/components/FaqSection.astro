---
import { client } from "../lib/client";
import { resolvedFaqEntries } from "../lib/client/faqPresets.ts";
import { ChevronDown } from "@lucide/astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const items = resolvedFaqEntries(client.profession, client.contact.bookingUrl);
---

<section class:list={["interior-faq", className]} data-component="panel.faq">
  <div><h2>Questions fréquentes</h2><p>Quelques repères avant de nous rencontrer.</p></div>
  <div class="home-faq-list">
    {
      items.map((item) => (
        <details data-component="faq.item">
          <summary>
            {item.question}
            <ChevronDown size={19} aria-hidden="true" />
          </summary>
          <p>{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
